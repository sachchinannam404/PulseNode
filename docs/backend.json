
{
  "entities": {
    "Patient": {
      "title": "Patient",
      "description": "A digital health record for a patient.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "dob": { "type": "string", "format": "date" },
        "gender": { "type": "string", "enum": ["Male", "Female", "Other"] },
        "bloodType": { "type": "string" },
        "condition": { "type": "string" },
        "status": { "type": "string", "enum": ["Critical", "Observation", "Stable", "Discharging"] },
        "attendingDoctor": { "type": "string" },
        "mrn": { "type": "string" },
        "lastUpdate": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "dob", "mrn"]
    },
    "Visit": {
      "title": "Visit",
      "description": "A clinical encounter record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "reason": { "type": "string" },
        "notes": { "type": "string" },
        "vitals": {
          "type": "object",
          "properties": {
            "temp": { "type": "string" },
            "bp": { "type": "string" },
            "heartRate": { "type": "string" }
          }
        }
      }
    },
    "Prescription": {
      "title": "Prescription",
      "description": "Medication prescribed to a patient.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "visitId": { "type": "string" },
        "medication": { "type": "string" },
        "dosage": { "type": "string" },
        "frequency": { "type": "string" },
        "duration": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/patients/{patientId}": {
      "schema": "Patient",
      "description": "Individual patient records"
    },
    "/patients/{patientId}/visits/{visitId}": {
      "schema": "Visit",
      "description": "History of visits for a specific patient"
    },
    "/patients/{patientId}/prescriptions/{prescriptionId}": {
      "schema": "Prescription",
      "description": "Prescriptions assigned to a patient"
    }
  }
}
